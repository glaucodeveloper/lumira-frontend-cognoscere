# Electron desktop config. Copy to .env; never commit the copy.

# Local Forge URL. Remote/tunneled URLs must use HTTPS.
COGNOSCERE_BASE_URL=http://127.0.0.1:19195
COGNOSCERE_SLUG=lumira
COGNOSCERE_UNIT_ID=lumira-cognoscere-monitor
COGNOSCERE_TIMEOUT_MS=240000

# PTA is only checked by Electron main process; never sent to Cognoscere.
LUMIRA_PTA_KEY=

# For an ngrok/port-router URL, the app reads PORT_ROUTER_KEY from this file.
# You may instead set PORT_ROUTER_KEY directly in this ignored .env file.
PORT_ROUTER_ENV_FILE=~/.config/port-router/router.env
# PORT_ROUTER_KEY=
