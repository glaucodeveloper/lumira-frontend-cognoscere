# Electron desktop config. Copy to .env; never commit the copy.

# Cognoscere Forge routed through the active ngrok tunnel. Remote URLs must use HTTPS.
COGNOSCERE_BASE_URL=https://ateliotic-jann-paragonless.ngrok-free.dev/19195
COGNOSCERE_SLUG=lumira
COGNOSCERE_UNIT_ID=lumira-cognoscere-monitor
COGNOSCERE_TIMEOUT_MS=240000

# Enter the Router API key in the app gate. Electron keeps it in main-process memory
# for this run and sends it only as X-Port-Router-Key to authenticate tunnel requests.
